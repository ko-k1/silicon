{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silicon.local/schemas/target-manifest.schema.json",
  "title": "silicon Target Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "hardware",
    "software",
    "protection",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "device_marketing_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_type": {
          "$ref": "#/$defs/assessedValue"
        }
      },
      "additionalProperties": true
    },
    "hardware": {
      "type": "object",
      "properties": {
        "soc": {
          "$ref": "#/$defs/assessedValue"
        },
        "architecture": {
          "$ref": "#/$defs/assessedValue"
        }
      },
      "additionalProperties": true
    },
    "software": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/assessedValue"
        },
        "build": {
          "$ref": "#/$defs/assessedValue"
        }
      },
      "additionalProperties": true
    },
    "protection": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/protectionState"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "partial",
            "verified"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "assessedValue": {
      "type": "object",
      "required": [
        "value",
        "state",
        "evidence"
      ],
      "properties": {
        "value": {},
        "state": {
          "enum": [
            "unknown",
            "pending",
            "user-specified",
            "observed",
            "inferred",
            "confirmed",
            "contradicted"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "protectionState": {
      "type": "object",
      "required": [
        "state",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "pending",
            "observed",
            "inferred",
            "confirmed",
            "not-applicable",
            "contradicted"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
